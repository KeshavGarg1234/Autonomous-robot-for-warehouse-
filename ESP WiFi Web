          <button class="testTabBtn" style="min-width:55px;" onclick="setRadZoom(5.0, this)">5.0m</button>
        </div>
        <div class="lidarRadarBox">
          <canvas id="lidarCanvas" width="400" height="400"></canvas>
        </div>
        <div class="radarLegend">
          <div class="sectorPill"><div class="n">F</div><div class="d" id="radF">--</div></div>
          <div class="sectorPill"><div class="n">FL</div><div class="d" id="radFL">--</div></div>
          <div class="sectorPill"><div class="n">FR</div><div class="d" id="radFR">--</div></div>
          <div class="sectorPill"><div class="n">L</div><div class="d" id="radL">--</div></div>
          <div class="sectorPill"><div class="n">R</div><div class="d" id="radR">--</div></div>
          <div class="sectorPill"><div class="n">BL</div><div class="d" id="radBL">--</div></div>
          <div class="sectorPill"><div class="n">BR</div><div class="d" id="radBR">--</div></div>
          <div class="sectorPill"><div class="n">B</div><div class="d" id="radB">--</div></div>
        </div>
        <div style="font-size: 10px; color: #64748b; margin-top: 6px;">
          Points: <span id="radarPts">0</span> | Unified Navigator on Port 8088
        </div>
      </div>

      <button class="btn stop" style="width: 100%; max-width: 280px; height: 48px; margin-top: 6px;" onclick="stopAuto()">EXIT TEST MODE</button>
    </div>
  </div>

  <div class="instructions">
    <b>Drive Priority:</b> Boots directly in Manual mode.<br>
    <b>Multi-Touch:</b> Hold 2 buttons — newest takes priority. Release to revert.<br>
    <b>20x4 LCD:</b> Live status, sensor health, and boot messages on rover display.<br>
    <b>Sensor Diagnostics:</b> Test live ultrasonics & 2D LiDAR radar mapping.
  </div>
</div>

<script>
let lockedCommand = null;
let activeCommand = null;
const DOUBLE_TAP_TIME = 350;
const ROTATE_HOLD_TIME = 220;
const buttonStates = new WeakMap();
const commandURLs = {
  forward: "/forward",
  backward: "/backward",
  rotateLeft: "/rotateLeft",
  rotateRight: "/rotateRight",
  rotateLeftStep: "/rotateLeftStep",
  rotateRightStep: "/rotateRightStep",
  auto: "/auto",
  lidar: "/lidar",
  dual: "/dual",
  test: "/test"
};

let pendingUrl = null;
let isSending = false;

// Multi-Touch Priority Stack
let touchStack = [];

function getActiveStackCmd() {
  if (touchStack.length > 0) return touchStack[touchStack.length - 1];
  return null;
}

function pushToStack(cmd, button, pointerId) {
  touchStack = touchStack.filter(e => e.cmd !== cmd);
  touchStack.push({ cmd, button, pointerId });
}

function removeFromStack(cmd) {
  touchStack = touchStack.filter(e => e.cmd !== cmd);
}

function updateStackVisuals() {
  document.querySelectorAll(".btn.pressed").forEach(b => b.classList.remove("pressed"));
  const top = getActiveStackCmd();
  if (top && !lockedCommand) {
    top.button.classList.add("pressed");
  }
}

function dispatchNext() {
  if (isSending || !pendingUrl) return;
  isSending = true;
  const url = pendingUrl;
  pendingUrl = null;

  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 600);

  fetch(url, { method: "GET", cache: "no-store", signal: controller.signal })
    .catch(() => {})
    .finally(() => {
      clearTimeout(timeoutId);
      isSending = false;
      if (pendingUrl) {
        dispatchNext();
      }
    });
}

function sendCommand(command) {
  if (!commandURLs[command]) return;
  pendingUrl = commandURLs[command];
  dispatchNext();
}

function sendStop() {
  activeCommand = null;
  pendingUrl = "/stop";
  dispatchNext();
}

function clearLocks() {
  lockedCommand = null;
  document.querySelectorAll(".btn.locked").forEach(button => { button.classList.remove("locked"); });
  updateLockText();
}

function stopAll() {
  clearLocks();
  touchStack = [];
  document.querySelectorAll(".btn.pressed").forEach(button => { button.classList.remove("pressed"); });
  sendStop();
  activeCommand = null;
}

function lockCommand(command, button) {
  document.querySelectorAll(".btn.locked").forEach(btn => { btn.classList.remove("locked"); });
  lockedCommand = command;
  activeCommand = command;
  button.classList.add("locked");
  touchStack = [];
  sendCommand(command);
  updateLockText();
}

function unlockCommand() {
  lockedCommand = null;
  document.querySelectorAll(".btn.locked").forEach(button => { button.classList.remove("locked"); });
  sendStop();
  updateLockText();
}

function updateLockText() {
  const lockText = document.getElementById("lockText");
  if (lockedCommand) {
    let readable = lockedCommand.replace("rotateLeft", "Turn Left").replace("rotateRight", "Turn Right").replace("forward", "Forward").replace("backward", "Reverse");
    lockText.textContent = "LOCKED: " + readable.toUpperCase();
  } else if (touchStack.length > 1) {
    lockText.textContent = "MULTI-TOUCH: " + touchStack.length + " buttons held";
  } else {
    lockText.textContent = "No movement locked";
  }
}

function startCommand(button, command, pointerId) {
  const state = buttonStates.get(button);
  if (!state) return;

  if (lockedCommand === command) {
    unlockCommand();
    return;
  }
  if (lockedCommand && lockedCommand !== command) {
    clearLocks();
  }

  const now = Date.now();
  const isDoubleTap = (now - state.lastTap <= DOUBLE_TAP_TIME);

  if (isDoubleTap) {
    state.lastTap = 0;
    clearTimeout(state.holdTimer);
    clearTimeout(state.stopTimer);
    lockCommand(command, button);
    return;
  }

  const isRotate = (command === "rotateLeft" || command === "rotateRight");
  pushToStack(command, button, pointerId);

  if (isRotate) {
    state.isHolding = false;
    clearTimeout(state.holdTimer);
    state.holdTimer = setTimeout(() => {
      if (state.isDown && lockedCommand !== command) {
        state.isHolding = true;
        const top = getActiveStackCmd();
        if (top && top.cmd === command) {
          activeCommand = command;
          sendCommand(command);
        }
      }
    }, ROTATE_HOLD_TIME);
  } else {
    activeCommand = command;
    sendCommand(command);
  }

  updateStackVisuals();
  updateLockText();
}

function endCommand(button, command) {
  const state = buttonStates.get(button);
  if (!state) return;

  state.isDown = false;
  clearTimeout(state.holdTimer);

  if (lockedCommand === command) {
    return;
  }

  const now = Date.now();
  const isRotate = (command === "rotateLeft" || command === "rotateRight");
  removeFromStack(command);

  if (isRotate) {
    if (state.isHolding) {
      state.isHolding = false;
      button.classList.remove("pressed");
      state.lastTap = 0;
      const prev = getActiveStackCmd();
      if (prev) {
        activeCommand = prev.cmd;
        sendCommand(prev.cmd);
        updateStackVisuals();
      } else {
        sendStop();
      }
    } else {
      const prev = getActiveStackCmd();
      if (!prev) {
        sendCommand(command + "Step");
        button.classList.add("pressed");
        setTimeout(() => {
          if (lockedCommand !== command) {
            button.classList.remove("pressed");
          }
        }, 120);
      } else {
        activeCommand = prev.cmd;
        sendCommand(prev.cmd);
        updateStackVisuals();
      }
      state.lastTap = now;
    }
  } else {
    button.classList.remove("pressed");
    state.lastTap = now;
    const prev = getActiveStackCmd();
    if (prev) {
      clearTimeout(state.stopTimer);
      activeCommand = prev.cmd;
      sendCommand(prev.cmd);
      updateStackVisuals();
    } else {
      clearTimeout(state.stopTimer);
      state.stopTimer = setTimeout(() => {
        if (lockedCommand !== command && touchStack.length === 0) {
          sendStop();
        }
      }, DOUBLE_TAP_TIME + 20);
    }
  }

  updateLockText();
}

document.querySelectorAll("[data-command]").forEach(button => {
  const command = button.dataset.command;
  const state = { isDown: false, holdTimer: null, stopTimer: null, lastTap: 0, isHolding: false };
  buttonStates.set(button, state);

  button.addEventListener("pointerdown", function(event) {
    event.preventDefault();
    if (event.button !== undefined && event.button !== 0) return;
    try { button.setPointerCapture(event.pointerId); } catch (e) {}
    clearTimeout(state.stopTimer);
    state.isDown = true;
    startCommand(button, command, event.pointerId);
  }, { passive: false });

  button.addEventListener("pointerup", function(event) {
    event.preventDefault();
    endCommand(button, command);
  }, { passive: false });

  button.addEventListener("pointercancel", function(event) {
    event.preventDefault();
    state.isDown = false;
    clearTimeout(state.holdTimer);
    state.isHolding = false;
    removeFromStack(command);
    if (lockedCommand !== command) {
      button.classList.remove("pressed");
      const prev = getActiveStackCmd();
      if (prev) {
        activeCommand = prev.cmd;
        sendCommand(prev.cmd);
        updateStackVisuals();
      } else {
        sendStop();
      }
    }
    updateLockText();
  }, { passive: false });

  button.addEventListener("contextmenu", function(event) { event.preventDefault(); });
});

// Mode Switcher
let activeMode = "basic";
let telemTimer = null;

function setMode(mode) {
  activeMode = mode;
  clearLocks();
  document.querySelectorAll(".btn.pressed").forEach(button => { button.classList.remove("pressed"); });
  activeCommand = null;

  const panels = ["basicControls", "autoControls", "lidarControls", "dualControls", "testControls"];
  panels.forEach(p => {
    const el = document.getElementById(p);
    if (el) el.classList.remove("show");
  });

  const buttons = ["basicMode", "autoMode", "lidarMode", "dualMode", "testMode"];
  buttons.forEach(b => {
    const el = document.getElementById(b);
    if (el) el.classList.remove("active");
  });

  const modeText = document.getElementById("modeText");

  if (telemTimer) {
    clearInterval(telemTimer);
    telemTimer = null;
  }

  if (mode === "basic") {
    document.getElementById("basicControls").classList.add("show");
    document.getElementById("basicMode").classList.add("active");
    modeText.textContent = "MANUAL (DRIVE PRIORITY)";
    sendStop();
  } else if (mode === "auto") {
    document.getElementById("autoControls").classList.add("show");
    document.getElementById("autoMode").classList.add("active");
    modeText.textContent = "ULTRASONIC AUTO (ACTIVE)";
    sendCommand("auto");
  } else if (mode === "lidar") {
    document.getElementById("lidarControls").classList.add("show");
    document.getElementById("lidarMode").classList.add("active");
    modeText.textContent = "2D LIDAR AUTO (ACTIVE)";
    sendCommand("lidar");
  } else if (mode === "dual") {
    document.getElementById("dualControls").classList.add("show");
    document.getElementById("dualMode").classList.add("active");
    modeText.textContent = "DUAL FUSION AUTO (ACTIVE)";
    sendCommand("dual");
  } else if (mode === "test") {
    document.getElementById("testControls").classList.add("show");
    document.getElementById("testMode").classList.add("active");
    modeText.textContent = "SENSOR DIAGNOSTICS & RADAR (TEST)";
    sendCommand("test");
    // Start fast telemetry polling
    telemTimer = setInterval(pollTelemetry, 180);
    pollTelemetry();
  }
}

function stopAuto() {
  stopAll();
  setMode("basic");
}

// ======================================================
// SENSOR TEST & DIAGNOSTICS LOGIC
// ======================================================
let currentTestTab = "all";
let latestTelemetry = { fc: 999, fl: 999, fr: 999, l: 999, r: 999, us_count: 5 };

function switchTestTab(tab) {
  currentTestTab = tab;
  document.querySelectorAll(".testTabBtn").forEach(b => b.classList.remove("active"));
  document.querySelectorAll(".coneItem").forEach(c => c.classList.remove("sel"));

  const ultraSec = document.getElementById("ultraSection");
  const radarSec = document.getElementById("radarSection");

  if (tab === "radar") {
    ultraSec.style.display = "none";
    radarSec.style.display = "flex";
    pollPiRadar();
  } else {
    ultraSec.style.display = "flex";
    radarSec.style.display = "none";

    const cone = document.getElementById("cone_" + tab);
    if (cone) cone.classList.add("sel");
  }

  // Highlight active tab
  event && event.target && event.target.classList.add("active");
  updateUltraDisplay();
}

function updateUltraDisplay() {
  const lbl = document.getElementById("ultraLabel");
  const num = document.getElementById("ultraNum");
  const bar = document.getElementById("ultraBar");

  let dist = 999;
  let name = "ALL 5 SENSORS ACTIVE";

  if (currentTestTab === "FC" || currentTestTab === "all") {
    dist = latestTelemetry.fc;
    name = "FRONT-CENTER SENSOR (0°)";
  } else if (currentTestTab === "FL") {
    dist = latestTelemetry.fl;
    name = "FRONT-LEFT SENSOR (30°)";
  } else if (currentTestTab === "FR") {
    dist = latestTelemetry.fr;
    name = "FRONT-RIGHT SENSOR (30°)";
  } else if (currentTestTab === "L") {
    dist = latestTelemetry.l;
    name = "LEFT SIDE SENSOR (90°)";
  } else if (currentTestTab === "R") {
    dist = latestTelemetry.r;
    name = "RIGHT SIDE SENSOR (90°)";
  }

  lbl.textContent = name;
  if (dist >= 990) {
    num.textContent = "CLEAR";
    bar.style.width = "100%";
    bar.style.background = "#10b981";
  } else {
    num.textContent = dist;
    const pct = Math.min(100, Math.max(5, (dist / 150) * 100));
    bar.style.width = pct + "%";
    bar.style.background = dist < 15 ? "#ef4444" : (dist < 35 ? "#f59e0b" : "#06b6d4");
  }
}

async function pollTelemetry() {
  try {
    const res = await fetch("/telemetry");
    if (res.ok) {
      const data = await res.json();

      // Proximity Alert Banner in All Driving Modes (only active when fleet tracking is ON)
      const pBox = document.getElementById("proxAlertBox");
      const pRssi = document.getElementById("proxRssiVal");
      if (data.prox_alert === 1 && data.fleet_enabled === 1) {
        if (pBox) pBox.style.display = "block";
        if (pRssi) pRssi.textContent = data.prox_rssi;
      } else {
        if (pBox) pBox.style.display = "none";
      }

      // Live Rover #2 signal readout in Fleet Settings
      const fRssi = document.getElementById("fleetLiveRssi");
      if (fRssi) {
        if (data.prox_rssi && data.prox_rssi > -990) {
          currentLiveRssi = data.prox_rssi;
          fRssi.textContent = data.prox_rssi + " dBm (DETECTED)";
          fRssi.style.color = (data.prox_rssi >= data.prox_stop_thresh) ? "#ef4444" : "#10b981";
        } else {
          fRssi.textContent = "-- dBm (OUT OF RANGE)";
          fRssi.style.color = "#64748b";
        }
      }

      const pThresh = document.getElementById("proxThreshDisp");
      if (pThresh && data.prox_stop_thresh) pThresh.textContent = data.prox_stop_thresh;

      if (activeMode !== "test") return;

      latestTelemetry = data;

      // Update badge states
      const dMega = document.getElementById("diagMega");
      const dPi = document.getElementById("diagPi");
      const dUS = document.getElementById("diagUS");

      dMega.textContent = data.mega_online ? "ONLINE" : "WAIT";
      dMega.className = "val " + (data.mega_online ? "ok" : "wait");

      dPi.textContent = data.rpi_ok ? "ONLINE" : "WAIT";
      dPi.className = "val " + (data.rpi_ok ? "ok" : "wait");

      dUS.textContent = data.us_count + "/5 OK";
      dUS.className = "val " + (data.us_count === 5 ? "ok" : (data.us_count >= 3 ? "wait" : "err"));

      // Update cone distances
      function setVal(id, v) {
        const el = document.getElementById(id);
        if (el) el.textContent = (v >= 990) ? "CLR" : v + "cm";
      }
      setVal("val_FC", data.fc);
      setVal("val_FL", data.fl);
      setVal("val_FR", data.fr);
      setVal("val_L", data.l);
      setVal("val_R", data.r);

      updateUltraDisplay();

      // Unpack 36 LiDAR rays received via wire (RPi -> Mega -> ESP8266)
      if (data.rays && data.rays.length === 36) {
        lastLidarPoints = [];
        for (let i = 0; i < 36; i++) {
          const dist = data.rays[i];
          if (dist > 12 && dist < 550) {
            const angle = i * 10;
            const rad = angle * Math.PI / 180;
            const x = dist * Math.sin(rad);
            const y = dist * Math.cos(rad);
            lastLidarPoints.push([angle, dist, x, y]);
          }
        }
        const ptsEl = document.getElementById("radarPts");
        if (ptsEl) ptsEl.textContent = lastLidarPoints.length;

        const connEl = document.getElementById("piConnStatus");
        if (connEl) {
          connEl.textContent = "● WIRED LINK ACTIVE (RPi -> Mega -> ESP | " + lastLidarPoints.length + " pts)";
          connEl.style.color = "#10b981";
        }

        if (data.sectors) {
          function sVal(id, v) {
            const el = document.getElementById(id);
            if (el) el.textContent = (v >= 900) ? "CLR" : Math.round(v) + "cm";
          }
          sVal("radF", data.sectors.F);
          sVal("radFL", data.sectors.FL);
          sVal("radFR", data.sectors.FR);
          sVal("radL", data.sectors.L);
          sVal("radR", data.sectors.R);
          sVal("radBL", data.sectors.BL);
          sVal("radBR", data.sectors.BR);
          sVal("radB", data.sectors.B);
        }

        if (currentTestTab === "radar") {
          renderRadarCanvas();
        }
      }
    }
  } catch (e) {}

  // Optional direct Pi Wi-Fi fetch fallback (only if wired points are empty)
  if (lastLidarPoints.length === 0) {
    pollPiRadar();
  }
}

// ======================================================
// 2D LIDAR RADAR MAP CANVAS
// ======================================================
const radarCanvas = document.getElementById("lidarCanvas");
const rCtx = radarCanvas ? radarCanvas.getContext("2d") : null;
let radarSweepAngle = 0;
let lastLidarPoints = [];
let targetPiIp = localStorage.getItem("rover_pi_ip") || "192.168.4.2";

function savePiIp() {
  const inp = document.getElementById("piIpInput");
  if (inp && inp.value.trim()) {
    targetPiIp = inp.value.trim();
    localStorage.setItem("rover_pi_ip", targetPiIp);
    const connEl = document.getElementById("piConnStatus");
    if (connEl) {
      connEl.textContent = "Connecting to http://" + targetPiIp + ":8088...";
      connEl.style.color = "#f59e0b";
    }
    pollPiRadar();
  }
}

async function pollPiRadar() {
  if (activeMode !== "test" || currentTestTab !== "radar") return;

  const url = "http://" + targetPiIp + ":8088/lidar_scan";
  const connEl = document.getElementById("piConnStatus");

  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 900);
    const piRes = await fetch(url, { mode: 'cors', signal: controller.signal });
    clearTimeout(timeoutId);

    if (piRes.ok) {
      const pData = await piRes.json();
      lastLidarPoints = pData.points || [];
      const ptsEl = document.getElementById("radarPts");
      if (ptsEl) ptsEl.textContent = lastLidarPoints.length;

      if (connEl) {
        const modeStr = pData.is_navigating ? ("NAVIGATING [" + pData.current_cmd + "]") : "STANDBY";
        connEl.textContent = "● CONNECTED: " + targetPiIp + " (" + lastLidarPoints.length + " pts | " + modeStr + ")";
        connEl.style.color = "#10b981";
      }

      if (pData.sectors) {
        function sVal(id, v) {
          const el = document.getElementById(id);
          if (el) el.textContent = (v >= 900) ? "CLR" : Math.round(v) + "cm";
        }
        sVal("radF", pData.sectors.F);
        sVal("radFL", pData.sectors.FL);
        sVal("radFR", pData.sectors.FR);
        sVal("radL", pData.sectors.L);
        sVal("radR", pData.sectors.R);
        sVal("radBL", pData.sectors.BL);
        sVal("radBR", pData.sectors.BR);
        sVal("radB", pData.sectors.B);
      }
    } else {
      if (connEl) {
        connEl.textContent = "○ HTTP " + piRes.status + " from " + url;
        connEl.style.color = "#ef4444";
      }
    }
  } catch (e) {
    if (connEl) {
      connEl.textContent = "○ Cannot reach " + url + " (Set Pi IP above)";
      connEl.style.color = "#ef4444";
    }
  }

  renderRadarCanvas();
}

let radarZoomMax = 1.5;

function setRadZoom(m, btn) {
  radarZoomMax = m;
  document.querySelectorAll('#radarSection .testTabBtn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderRadarCanvas();
}

function renderRadarCanvas() {
  if (!rCtx || !radarCanvas) return;
  const W = radarCanvas.width, H = radarCanvas.height;
  const CX = W / 2, CY = H / 2;
  const SCALE = (W / 2 - 16) / (radarZoomMax * 100);

  rCtx.fillStyle = "#05070a";
  rCtx.fillRect(0, 0, W, H);

  // Concentric Range Rings
  rCtx.lineWidth = 1;
  const step = radarZoomMax <= 2.0 ? 0.5 : 1.0;
  for (let r = step; r <= radarZoomMax; r += step) {
    const rad = r * 100 * SCALE;
    rCtx.strokeStyle = "#162832";
    rCtx.beginPath();
    rCtx.arc(CX, CY, rad, 0, Math.PI * 2);
    rCtx.stroke();

    rCtx.fillStyle = "#64748b";
    rCtx.font = "10px sans-serif";
    rCtx.fillText(r.toFixed(1) + "m", CX + 4, CY - rad + 11);
  }

  // Crosshair Axes
  rCtx.strokeStyle = "#162832";
  rCtx.beginPath();
  rCtx.moveTo(CX, 0); rCtx.lineTo(CX, H);
  rCtx.moveTo(0, CY); rCtx.lineTo(W, CY);
  rCtx.stroke();

  // Rotating Radar Sweep Beam
  radarSweepAngle = (radarSweepAngle + 0.08) % (Math.PI * 2);
  const sx = CX + (CX - 12) * Math.sin(radarSweepAngle);
  const sy = CY - (CY - 12) * Math.cos(radarSweepAngle);
  rCtx.strokeStyle = "rgba(6, 182, 212, 0.4)";
  rCtx.lineWidth = 2;
  rCtx.beginPath();
  rCtx.moveTo(CX, CY);
  rCtx.lineTo(sx, sy);
  rCtx.stroke();

  // Green Dotted Laser Points (Walls & Objects)
  if (lastLidarPoints.length > 0) {
    lastLidarPoints.forEach(pt => {
      const x = pt[2], y = pt[3], d = pt[1];
      const px = CX + x * SCALE;
      const py = CY - y * SCALE;

      rCtx.fillStyle = d < 25 ? "#ef4444" : (d < 45 ? "#f59e0b" : "#10b981");
      rCtx.beginPath();
      rCtx.arc(px, py, 3.0, 0, Math.PI * 2);
      rCtx.fill();
    });
  }

  // Compact Center Rover Marker (Small 4px dot)
  rCtx.fillStyle = "#06b6d4";
  rCtx.beginPath();
  rCtx.arc(CX, CY, 4, 0, Math.PI * 2);
  rCtx.fill();

  // Red Heading Arrow (Forward = 0°)
  rCtx.strokeStyle = "#ef4444";
  rCtx.fillStyle = "#ef4444";
  rCtx.lineWidth = 2;
  rCtx.beginPath();
  rCtx.moveTo(CX, CY);
  rCtx.lineTo(CX, CY - 14);
  rCtx.stroke();

  rCtx.beginPath();
  rCtx.moveTo(CX, CY - 18);
  rCtx.lineTo(CX - 4, CY - 12);
