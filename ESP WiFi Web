// ======================================================
// HTTP HANDLERS
// ======================================================

void handleRoot() {
  server.sendHeader("Connection", "close");
  server.send_P(200, "text/html", MAIN_PAGE);
}

void sendFastOk() {
  server.sendHeader("Connection", "close");
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate");
  server.send(200, "text/plain", "1");
}

void handleForward()        { Serial.print('F'); sendFastOk(); }
void handleBackward()       { Serial.print('B'); sendFastOk(); }
void handleLeft()           { Serial.print('L'); sendFastOk(); }
void handleRight()          { Serial.print('R'); sendFastOk(); }
void handleRotateLeft()     { Serial.print('Q'); sendFastOk(); }
void handleRotateRight()    { Serial.print('E'); sendFastOk(); }
void handleRotateLeftStep()  { Serial.print('q'); sendFastOk(); }
void handleRotateRightStep() { Serial.print('e'); sendFastOk(); }
void handleStop()           { Serial.print('S'); sendFastOk(); }
void handleAuto()           { Serial.print('A'); sendFastOk(); }
void handleLidar()          { Serial.print('D'); sendFastOk(); }
void handleDual()           { Serial.print('H'); sendFastOk(); }
void handleTest()           { Serial.print('T'); sendFastOk(); }

void handleTelemetry() {
  server.sendHeader("Connection", "close");
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate");
  server.sendHeader("Access-Control-Allow-Origin", "*");

  unsigned long now = millis();
  bool megaOnline = (lastMegaTelemTime > 0 && (now - lastMegaTelemTime < 3500));
  bool rpiOnline = (telemRpiOk == 1) || (lastLidarRaysTime > 0 && (now - lastLidarRaysTime < 3000));
  bool lidarOnline = (telemLidarOk == 1) || (lastLidarRaysTime > 0 && (now - lastLidarRaysTime < 3000));

  String json = "{";
  json += "\"fc\":" + String(telemFC) + ",";
  json += "\"fl\":" + String(telemFL) + ",";
  json += "\"fr\":" + String(telemFR) + ",";
  json += "\"l\":" + String(telemL) + ",";
  json += "\"r\":" + String(telemR) + ",";
  json += "\"us_count\":" + String(telemUSCount) + ",";
  json += "\"rpi_ok\":" + String(rpiOnline ? 1 : 0) + ",";
  json += "\"lidar_ok\":" + String(lidarOnline ? 1 : 0) + ",";
  json += "\"mega_online\":" + String(megaOnline ? 1 : 0) + ",";
  json += "\"mode\":" + String(telemMode) + ",";
  json += "\"prox_alert\":" + String(roverProximityAlert ? 1 : 0) + ",";
  json += "\"prox_rssi\":" + String(lastRoverRssi) + ",";
  json += "\"fleet_enabled\":" + String(fleetTrackingEnabled ? 1 : 0) + ",";
  json += "\"prox_stop_thresh\":" + String(rssiStopThreshold) + ",";
  json += "\"prox_resume_thresh\":" + String(rssiResumeThreshold) + ",";
  json += "\"mega_prox_hold\":" + String(telemMegaProxHold) + ",";

  // 36-ray LiDAR distances for 2D room map over wire (RPi -> Mega -> ESP)
  json += "\"rays\":[";
  for (int i = 0; i < 36; i++) {
    json += String(lidarRays[i]);
    if (i < 35) json += ",";
  }
  json += "],";

  // 8 sector minimums
  int sF  = lidarRays[0];
  int sFL = min(lidarRays[4], lidarRays[5]);
  int sL  = lidarRays[9];
  int sBL = min(lidarRays[13], lidarRays[14]);
  int sB  = lidarRays[18];
  int sBR = min(lidarRays[22], lidarRays[23]);
  int sR  = lidarRays[27];
  int sFR = min(lidarRays[31], lidarRays[32]);

  json += "\"sectors\":{";
  json += "\"F\":" + String(sF) + ",";
  json += "\"FL\":" + String(sFL) + ",";
  json += "\"L\":" + String(sL) + ",";
  json += "\"BL\":" + String(sBL) + ",";
  json += "\"B\":" + String(sB) + ",";
  json += "\"BR\":" + String(sBR) + ",";
  json += "\"R\":" + String(sR) + ",";
  json += "\"FR\":" + String(sFR);
  json += "}";

  json += "}";
  server.send(200, "application/json", json);
}

void handleSetFleet() {
  server.sendHeader("Connection", "close");
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate");
  server.sendHeader("Access-Control-Allow-Origin", "*");
  if (server.hasArg("enabled")) {
    fleetTrackingEnabled = (server.arg("enabled") == "1");
    if (!fleetTrackingEnabled && roverProximityAlert) {
      roverProximityAlert = false;
      proximityConsecutiveHits = 0;
      Serial.print('p'); // Unfreeze Mega immediately
    }
  }
  if (server.hasArg("thresh")) {
    int t = server.arg("thresh").toInt();
    if (t >= -75 && t <= -35) {
      rssiStopThreshold = t;
      rssiResumeThreshold = t - 8;
    }
  }
  sendFastOk();
}

void handleNotFound() {
  server.sendHeader("Connection", "close");
  server.send(404, "text/plain", "Not Found");
}

// ======================================================
// TELEMETRY PARSER (from Arduino Mega Serial1 TX1)
// ======================================================
void parseMegaTelemetry(String line) {
  // Format: "fc,fl,fr,l,r,healthy_count,rpi_ok,lidar_ok,mode,prox_hold"
  int vals[10];
  int idx = 0;
  int start = 0;
  for (int i = 0; i <= line.length() && idx < 10; i++) {
    if (i == line.length() || line.charAt(i) == ',') {
      vals[idx++] = line.substring(start, i).toInt();
      start = i + 1;
    }
  }
  if (idx >= 6) {
    telemFC = vals[0];
    telemFL = vals[1];
    telemFR = vals[2];
    telemL  = vals[3];
    telemR  = vals[4];
    telemUSCount = vals[5];
    if (idx >= 7) telemRpiOk = vals[6];
    if (idx >= 8) telemLidarOk = vals[7];
    if (idx >= 9) telemMode = vals[8];
    if (idx >= 10) telemMegaProxHold = vals[9];
    lastMegaTelemTime = millis();
  }
}

void parseLidarTelemetry(String line) {
  // Format: "d0,d1,d2,...,d35"
  int idx = 0;
  int start = 0;
  for (int i = 0; i <= line.length() && idx < 36; i++) {
    if (i == line.length() || line.charAt(i) == ',') {
      lidarRays[idx++] = line.substring(start, i).toInt();
      start = i + 1;
    }
  }
  if (idx >= 36) {
    lastLidarRaysTime = millis();
    telemRpiOk = 1;
    telemLidarOk = 1;
  }
}

// ======================================================
// SETUP
// ======================================================

void setup() {
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, HIGH);

  for (int i = 0; i < 36; i++) lidarRays[i] = 999;

  Serial.begin(115200);
  delay(100);

  Serial.println();
  Serial.println("==============================================");
  Serial.println(" ESP8266 MOTOR CONTROLLER & DIAGNOSTICS WEB");
  Serial.println("==============================================");

  // Robust Wi-Fi AP+STA Initialization (AP for Phone Remote, STA for Channel 1 Beacon Scan)
  WiFi.persistent(false);
  WiFi.disconnect(true);
  delay(150);
  WiFi.mode(WIFI_AP_STA);
  delay(100);

  // Configure AP network IP: 192.168.4.1
  IPAddress apIP(192, 168, 4, 1);
  IPAddress subnet(255, 255, 255, 0);
  WiFi.softAPConfig(apIP, apIP, subnet);
  
  // Start Access Point: Channel 1 (universal standard), visible, max 4 clients
  bool apSuccess = WiFi.softAP("MECANUM_CAR", "12345678", 1, 0, 4);
  WiFi.setOutputPower(20.5); // Maximum transmission power for strong range

  if (apSuccess) {
    Serial.println(F("[WIFI] AP 'MECANUM_CAR' started successfully on Channel 1!"));
    Serial.print(F("[WIFI] IP Address: "));
    Serial.println(WiFi.softAPIP());
    for (int i = 0; i < 3; i++) {
      digitalWrite(LED_BUILTIN, LOW);
      delay(80);
      digitalWrite(LED_BUILTIN, HIGH);
      delay(80);
    }
    digitalWrite(LED_BUILTIN, LOW); // Solid ON = Wi-Fi AP Live
  } else {
    Serial.println(F("[WIFI] ERROR: Failed to start Access Point!"));
  }

  // HTTP Routes
  server.on("/", handleRoot);
  server.on("/forward", handleForward);
  server.on("/backward", handleBackward);
  server.on("/left", handleLeft);
  server.on("/right", handleRight);
  server.on("/rotateLeft", handleRotateLeft);
  server.on("/rotateRight", handleRotateRight);
  server.on("/rotateLeftStep", handleRotateLeftStep);
  server.on("/rotateRightStep", handleRotateRightStep);
  server.on("/stop", handleStop);
  server.on("/auto", handleAuto);
  server.on("/lidar", handleLidar);
  server.on("/dual", handleDual);
  server.on("/test", handleTest);
  server.on("/telemetry", handleTelemetry);
  server.on("/set_fleet", handleSetFleet);
  server.onNotFound(handleNotFound);

  server.begin();
  Serial.println(F("HTTP Server ready at http://192.168.4.1"));
}

// ======================================================
// BACKGROUND ROVER-TO-ROVER PROXIMITY SCANNER (CHANNEL 1)
// ======================================================
void checkRoverProximity() {
  unsigned long now = millis();

  // If Fleet Tracking is disabled by user on web remote:
  if (!fleetTrackingEnabled) {
    proximityConsecutiveHits = 0;
    if (roverProximityAlert) {
      roverProximityAlert = false;
      Serial.print('p'); // Immediately unfreeze Mega
    }
    return;
  }

  // 1. Trigger asynchronous scan on Channel 1 every 250ms
  // Staying on Channel 1 means the radio NEVER hops channels, keeping AP/Web alive!
  if (!isScanning) {
    if (now - lastScanStartTime >= 250) {
      int8_t res = WiFi.scanNetworks(true /* async */, true /* show_hidden */, 1 /* channel 1 */);
      if (res == WIFI_SCAN_RUNNING || res >= 0) {
        isScanning = true;
        lastScanStartTime = now;
      }
    }
  } else {
    // 2. Check if the asynchronous channel 1 scan has completed
    int16_t n = WiFi.scanComplete();
    if (n >= 0) {
      isScanning = false;
      bool foundTarget = false;
      int strongestRssi = -999;

      for (int i = 0; i < n; i++) {
        if (WiFi.SSID(i) == TARGET_ROVER_BEACON) {
          foundTarget = true;
          strongestRssi = WiFi.RSSI(i);
          break;
        }
      }
      WiFi.scanDelete(); // Critical: prevent internal memory leak

      // 3. Proximity Decision Logic with 2-hit Debounce Filter & Hysteresis
      if (foundTarget) {
        lastBeaconSeenTime = now;
        lastRoverRssi = strongestRssi;

        // Signal stronger than Stop Threshold (e.g. -48 dBm)
        if (strongestRssi >= rssiStopThreshold) {
          if (proximityConsecutiveHits < 255) proximityConsecutiveHits++;
          // Require 2 consecutive strong hits so single RF noise spike does not freeze rover
          if (!roverProximityAlert && proximityConsecutiveHits >= 2) {
            roverProximityAlert = true;
            Serial.print('P'); // Signal Arduino Mega: PROXIMITY SAFETY STOP!
          }
        }
        // Signal weaker than Resume Threshold (e.g. -56 dBm) -> Clear Stop
        else if (strongestRssi < rssiResumeThreshold) {
          proximityConsecutiveHits = 0;
          if (roverProximityAlert) {
            roverProximityAlert = false;
            Serial.print('p'); // Signal Arduino Mega: PROXIMITY CLEAR, RESUME!
          }
        } else {
          // In the deadband between stop and resume
          if (!roverProximityAlert) proximityConsecutiveHits = 0;
        }
      } else {
        // Beacon not detected in this scan - check timeout
        lastRoverRssi = -999;
        proximityConsecutiveHits = 0;
        if (roverProximityAlert && (now - lastBeaconSeenTime > BEACON_TIMEOUT_MS)) {
          roverProximityAlert = false;
          Serial.print('p'); // Signal Arduino Mega: PROXIMITY CLEAR, RESUME!
        }
      }
    } else if (n == WIFI_SCAN_FAILED) {
      isScanning = false;
    }
  }
}

// ======================================================
// LOOP
// ======================================================

void loop() {
  server.handleClient();
  checkRoverProximity(); // Non-blocking background rover proximity check

  // FAILSAFE RESYNC: If Mega says it is currently in safety hold, but ESP has NO alert
  // or Fleet Tracking is disabled, immediately send 'p' to release it!
  if (telemMegaProxHold == 1 && (!roverProximityAlert || !fleetTrackingEnabled)) {
    Serial.print('p');
  }

  // Read Telemetry stream from Arduino Mega safely
  // (Bound to at most 128 bytes per pass to prevent starving the Wi-Fi beacon)
  int bytesRead = 0;
  while (Serial.available() > 0 && bytesRead < 128) {
    bytesRead++;
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      if (megaSerialBuf.startsWith("U:")) {
        parseMegaTelemetry(megaSerialBuf.substring(2));
      } else if (megaSerialBuf.startsWith("L:")) {
        parseLidarTelemetry(megaSerialBuf.substring(2));
      }
      megaSerialBuf = "";
    } else {
      megaSerialBuf += c;
      if (megaSerialBuf.length() > 240) megaSerialBuf = "";
    }
  }

  yield(); // Crucial: Yields CPU to ESP8266 background WiFi stack & resets software watchdog
}
