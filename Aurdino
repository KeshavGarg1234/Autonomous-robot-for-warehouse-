// ======================================================
// SETUP
// ======================================================
void setup() {
  Serial.begin(115200);   // USB to Raspberry Pi (/dev/ttyACM0)
  Serial1.begin(115200);  // ESP8266 TX -> Mega RX1 (Pin 19), Mega TX1 -> Pin 18 via divider
  Serial2.begin(115200);  // Optional RPi GPIO UART (RX2=17, TX2=16)

  pinMode(FL_IN1, OUTPUT); pinMode(FL_IN2, OUTPUT);
  pinMode(FR_IN1, OUTPUT); pinMode(FR_IN2, OUTPUT);
  pinMode(RL_IN1, OUTPUT); pinMode(RL_IN2, OUTPUT);
  pinMode(RR_IN1, OUTPUT); pinMode(RR_IN2, OUTPUT);

  pinMode(TRIG_FC, OUTPUT); pinMode(ECHO_FC, INPUT);
  pinMode(TRIG_FL, OUTPUT); pinMode(ECHO_FL, INPUT);
  pinMode(TRIG_FR, OUTPUT); pinMode(ECHO_FR, INPUT);
  pinMode(TRIG_L,  OUTPUT); pinMode(ECHO_L,  INPUT);
  pinMode(TRIG_R,  OUTPUT); pinMode(ECHO_R,  INPUT);

  digitalWrite(TRIG_FC, LOW);
  digitalWrite(TRIG_FL, LOW);
  digitalWrite(TRIG_FR, LOW);
  digitalWrite(TRIG_L,  LOW);
  digitalWrite(TRIG_R,  LOW);

  servoFL.attach(SERVO_FL_PIN);
  servoFR.attach(SERVO_FR_PIN);
  centerServos();
  stopMotors();

  // Initialize 20x4 LCD with 400kHz fast I2C
  initLcdDisplay();

  // Initial sweep of 5 ultrasonic sensors to calibrate health
  for (int i = 0; i < 5; i++) {
    pollNextUltrasonic();
    delay(15);
  }

  if (lcdFound && activeLcd) {
    activeLcd->setCursor(0, 2);
    activeLcd->print(F("Sensors: "));
    activeLcd->print(healthySensorCount);
    activeLcd->print(F("/5 Active "));
    activeLcd->setCursor(0, 3);
    activeLcd->print(F("Drive Mode: MANUAL  "));
    delay(400);
  }

  delay(50);
  while (Serial1.available() > 0) Serial1.read();
  flushPiSerial();

  Serial.println(F("================================================"));
  Serial.println(F(" Arduino Mega 4WD Skid-Steer Controller Ready"));
  Serial.println(F(" Modes: MANUAL | ULTRASONIC | LIDAR | DUAL | TEST"));
  Serial.println(F(" LCD 20x4 Fast-I2C Online"));
  Serial.println(F("================================================"));
}

// ======================================================
// RASPBERRY PI SERIAL DISPATCHER (Zero-Latency for Drive)
// ======================================================
void processPiSerial() {
  unsigned long now = millis();

  // Safety Interlock: When another rover is in proximity, ignore drive commands
  if (isProximityHold) {
    stopMotors();
    while (Serial.available() > 0) Serial.read();
    while (Serial2.available() > 0) Serial2.read();
    return;
  }

  // 1. IN AUTONOMOUS DRIVING (LiDAR or Dual Fusion):
  // ZERO-LATENCY DIRECT DISPATCH: read raw bytes immediately with 0ms buffering!
  if (currentMode == MODE_LIDAR || currentMode == MODE_DUAL_FUSION) {
    char latestCmd = 0;
    while (Serial.available() > 0) {
      char c = Serial.read();
      if (isValidPiCommand(c)) {
        latestCmd = c;
      }
    }
    while (Serial2.available() > 0) {
      char c = Serial2.read();
      if (isValidPiCommand(c)) {
        latestCmd = c;
      }
    }

    if (latestCmd != 0) {
      lastPiMsgTime = now;
      lastLidarCmdTime = now;
      lastPiCmd = latestCmd;
      if (currentMode == MODE_LIDAR) {
        executeMotorCommand(latestCmd);
      } else if (currentMode == MODE_DUAL_FUSION) {
        runDualFusion(latestCmd, true);
      }
    }
    return;
  }

  // 2. IN SENSOR TEST MODE: buffer lines to forward 36-ray LiDAR map to ESP8266 over Serial1
  if (currentMode == MODE_TEST) {
    while (Serial.available() > 0) {
      char c = Serial.read();
      if (c == '\n' || c == '\r') {
        if (piSerialBuf.startsWith("L:")) {
          lastPiMsgTime = now;
          Serial1.println(piSerialBuf);
        }
        piSerialBuf = "";
      } else {
        if (piSerialBuf.length() < 240) {
          piSerialBuf += c;
        } else {
          piSerialBuf = "";
        }
      }
    }
    return;
  }

  // 3. IN MANUAL OR ULTRASONIC MODES: drain serial buffers
  while (Serial.available() > 0) Serial.read();
  while (Serial2.available() > 0) Serial2.read();
  piSerialBuf = "";
}

// ======================================================
// MAIN LOOP
// ======================================================
void loop() {
  unsigned long now = millis();

  // 1. Always prioritize ESP8266 Web UI commands (with noise/reboot filter)
  if (Serial1.available() > 0) {
    processEspCommand();
  }

  // 2. Process Raspberry Pi serial commands
  processPiSerial();

  // 3. Poll ultrasonic sensors round-robin in Ultrasonic, Dual Fusion, or Test mode
  if (currentMode == MODE_ULTRASONIC || currentMode == MODE_DUAL_FUSION || currentMode == MODE_TEST) {
    if (now - lastSensorPollTime >= SENSOR_POLL_INTERVAL_MS) {
      lastSensorPollTime = now;
      pollNextUltrasonic();
    }
  }

  // 4. Periodic Telemetry Stream to ESP8266 over Serial1 (every 120ms)
  if (now - lastTelemetrySendTime >= 120) {
    lastTelemetrySendTime = now;
    sendTelemetryToEsp();
  }

  // 5. Update 20x4 LCD Display
  // During autonomous driving, update at 500ms so LCD never contends for CPU cycles
  unsigned long lcdInterval = (currentMode == MODE_LIDAR || currentMode == MODE_DUAL_FUSION) ? 500 : 250;
  if (now - lastLcdUpdateTime >= lcdInterval) {
    lastLcdUpdateTime = now;
    updateLcdDisplay();
  }

  // 6. Mode-specific execution
  if (isProximityHold) {
    stopMotors(); // Rigidly freeze motors while other rover is in proximity
  } else {
    switch (currentMode) {
      case MODE_MANUAL:
        if (isStepping && now >= stepEndTime) {
          stopMotors();
          isStepping = false;
        }
        break;

      case MODE_TEST:
        stopMotors(); // Motors strictly halted in diagnostic mode
        if (now - lastLidarResyncTime > LIDAR_RESYNC_INTERVAL) {
          lastLidarResyncTime = now;
          sendPiMessage("LIDAR:TEST");
        }
        break;

      case MODE_ULTRASONIC:
        runUltrasonicAuto();
        break;

      case MODE_LIDAR:
      case MODE_DUAL_FUSION: {
        // Watchdog: pause motors if Pi stops sending, and resync LIDAR:START
        if (now - lastLidarCmdTime > LIDAR_TIMEOUT_MS) {
          stopMotors();
          if (now - lastLidarResyncTime > LIDAR_RESYNC_INTERVAL) {
            lastLidarResyncTime = now;
            sendPiMessage("LIDAR:START");
          }
          break;
        }

        if (currentMode == MODE_DUAL_FUSION) {
          runDualFusion(lastPiCmd, false);
        }
        break;
      }
    }
  }
}

// ======================================================
// LCD 20x4 FUNCTIONS (Fast I2C 400kHz)
// ======================================================
void initLcdDisplay() {
  Wire.begin();
  Wire.setClock(400000); // 400kHz Fast I2C mode: cuts transmission time from 30ms to 7ms!
  delay(50); // Allow LCD controller power rise
  
  uint8_t foundAddr = 0;
  // Quick probe standard I2C backpack addresses (0x27 or 0x3F)
  Wire.beginTransmission(0x27);
  if (Wire.endTransmission() == 0) foundAddr = 0x27;
  if (foundAddr == 0) {
    Wire.beginTransmission(0x3F);
    if (Wire.endTransmission() == 0) foundAddr = 0x3F;
  }
  // Full bus scan if backpack has custom address jumpers
  if (foundAddr == 0) {
    for (uint8_t addr = 0x08; addr <= 0x77; addr++) {
      Wire.beginTransmission(addr);
      if (Wire.endTransmission() == 0) {
        foundAddr = addr;
        break;
      }
    }
  }

  if (foundAddr != 0) {
    activeLcd = new LiquidCrystal_I2C(foundAddr, 20, 4);
    lcdFound = true;
    activeLcd->init();
    activeLcd->backlight();
    activeLcd->clear();
    activeLcd->setCursor(0, 0); activeLcd->print(F("* AUTONOMOUS ROVER *"));
    activeLcd->setCursor(0, 1); activeLcd->print(F("Booting System...   "));
    activeLcd->setCursor(0, 2); activeLcd->print(F("Sensors Check...    "));
    activeLcd->setCursor(0, 3); activeLcd->print(F("Connecting ESP & Pi "));
  } else {
    lcdFound = false;
  }
}

void updateLcdDisplay() {
  if (!lcdFound || !activeLcd) return;

  // Proximity Alert Override on 20x4 LCD
  if (isProximityHold) {
    activeLcd->setCursor(0, 0);
    activeLcd->print(F("! ROVER ALERT STOP !"));
    activeLcd->setCursor(0, 1);
    activeLcd->print(F("ESP:OK  | PROX:NEAR "));
    activeLcd->setCursor(0, 2);
    activeLcd->print(F("COLLISION AVOIDANCE "));
    activeLcd->setCursor(0, 3);
    activeLcd->print(F("HOLD: ROVER IN RANGE"));
    return;
  }

  unsigned long now = millis();
  bool espOk = (lastEspCmdTime > 0 && (now - lastEspCmdTime < 4500));
  bool rpiOk = (lastLidarCmdTime > 0 && (now - lastLidarCmdTime < 3500)) || 
               (lastPiMsgTime > 0 && (now - lastPiMsgTime < 3500));

  // Row 0: Title & Mode
  activeLcd->setCursor(0, 0);
  switch (currentMode) {
    case MODE_MANUAL:      activeLcd->print(F("[ROVER] MANUAL DRIVE")); break;
    case MODE_ULTRASONIC:  activeLcd->print(F("[ROVER] ULTRASONIC  ")); break;
    case MODE_LIDAR:       activeLcd->print(F("[ROVER] 2D RPLIDAR  ")); break;
    case MODE_DUAL_FUSION: activeLcd->print(F("[ROVER] DUAL FUSION ")); break;
    case MODE_TEST:        activeLcd->print(F("[ROVER] SENSOR TEST ")); break;
  }

  // Row 1: Wi-Fi ESP8266 & Raspberry Pi link status
  activeLcd->setCursor(0, 1);
  activeLcd->print(F("ESP:"));
  activeLcd->print(espOk ? F("OK  ") : F("WAIT"));
  activeLcd->print(F(" | RPi:"));
  activeLcd->print(rpiOk ? F("OK  ") : F("WAIT"));

  // Row 2: Ultrasonic sensor health count & LiDAR health
  activeLcd->setCursor(0, 2);
  activeLcd->print(F("US:"));
  activeLcd->print(healthySensorCount);
  activeLcd->print(F("/5 OK | LDR:"));
  activeLcd->print(rpiOk ? F("OK  ") : F("WAIT"));

  // Row 3: Dynamic context information
  activeLcd->setCursor(0, 3);
  if (currentMode == MODE_TEST) {
    activeLcd->print(F("TEST: LIVE SENSORS  "));
  } else if (currentMode == MODE_MANUAL) {
    activeLcd->print(F("READY: DRIVE ENABLED"));
  } else {
    // Show live front distances
    activeLcd->print(F("FC:"));
    if (distFC >= 999) activeLcd->print(F("CLR"));
    else { if (distFC < 10) activeLcd->print(' '); activeLcd->print(distFC); }
    activeLcd->print(F(" FL:"));
    if (distFL >= 999) activeLcd->print(F("CLR"));
    else { if (distFL < 10) activeLcd->print(' '); activeLcd->print(distFL); }
    activeLcd->print(F(" FR:"));
    if (distFR >= 999) activeLcd->print(F("CLR"));
    else { if (distFR < 10) activeLcd->print(' '); activeLcd->print(distFR); }
    activeLcd->print(F("cm"));
  }
}

// ======================================================
// TELEMETRY STREAM TO ESP8266
// ======================================================
void sendTelemetryToEsp() {
  unsigned long now = millis();
  bool rpiOk = (lastLidarCmdTime > 0 && (now - lastLidarCmdTime < 3500)) || 
               (lastPiMsgTime > 0 && (now - lastPiMsgTime < 3500));
  bool lidarOk = (currentMode == MODE_LIDAR || currentMode == MODE_DUAL_FUSION) && rpiOk;

  // Compact packet format: "U:fc,fl,fr,l,r,healthy_count,rpi_ok,lidar_ok,mode,prox_hold\n"
  Serial1.print(F("U:"));
  Serial1.print(distFC); Serial1.print(',');
  Serial1.print(distFL); Serial1.print(',');
  Serial1.print(distFR); Serial1.print(',');
  Serial1.print(distL);  Serial1.print(',');
  Serial1.print(distR);  Serial1.print(',');
  Serial1.print(healthySensorCount); Serial1.print(',');
  Serial1.print(rpiOk ? 1 : 0); Serial1.print(',');
  Serial1.print(lidarOk ? 1 : 0); Serial1.print(',');
  Serial1.print((int)currentMode); Serial1.print(',');
  Serial1.print(isProximityHold ? 1 : 0);
  Serial1.print('\n');
}

// ======================================================
// ESP8266 COMMAND PARSER WITH BOOT-BANNER / EMI FILTER
// ======================================================
bool isValidEspCommand(char c) {
  switch (c) {
    case 'F': case 'B': case 'L': case 'R':
    case 'Q': case 'E': case 'q': case 'e':
    case 'S': case 'A': case 'D': case 'H':
    case 'T': case 'M':
    case 'P': case 'p': // Proximity Safety Hold ('P') and Resume ('p')
      return true;
    default:
      return false;
  }
}

bool isValidPiCommand(char c) {
  switch (c) {
    case 'F': case 'B': case 'L': case 'R':
    case 'Q': case 'E': case 'I': case 'O':
    case 'J': case 'K': case 'S':
      return true;
    default:
      return false;
  }
}

void processEspCommand() {
  delay(2);
  lastEspCmdTime = millis();

  if (Serial1.available() > 2) {
    bool isBannerOrNoise = false;
    char lastValid = 0;
    while (Serial1.available() > 0) {
      char c = Serial1.read();
      if (!isValidEspCommand(c)) {
        isBannerOrNoise = true;
      } else {
        lastValid = c;
      }
    }
    if (isBannerOrNoise) {
      unsigned long drainStart = millis();
      while (millis() - drainStart < 120) {
        while (Serial1.available() > 0) Serial1.read();
      }
      return;
    }
    if (lastValid != 0) {
      executeEspCommand(lastValid);
    }
    return;
  }

  while (Serial1.available() > 0) {
    char cmd = Serial1.read();
    if (isValidEspCommand(cmd)) {
      executeEspCommand(cmd);
    }
  }
}

void executeEspCommand(char cmd) {
  isStepping = false;

  // ======================================================
  // PROXIMITY SAFETY INTERLOCK (ROVER-TO-ROVER AVOIDANCE)
  // ======================================================
  if (cmd == 'P') {
    isProximityHold = true;
    stopMotors();          // Freeze all 4 wheels immediately
    updateLcdDisplay();
    return;
  }

  if (cmd == 'p') {
    isProximityHold = false;
    // Resume previous autonomous mode smoothly
    if (currentMode == MODE_ULTRASONIC) {
      autoState = AUTO_IDLE; // Restarts forward motion safely
    }
    updateLcdDisplay();
    return;
  }

  if (cmd == 'A') {
    currentMode = MODE_ULTRASONIC;
    autoState = AUTO_IDLE;
    centerServos();
    stopMotors();
    sendPiMessage("LIDAR:STOP");
    flushPiSerial();
    updateLcdDisplay();
    return;
  }

  if (cmd == 'D') {
    currentMode = MODE_LIDAR;
    lastLidarCmdTime = millis();
    lastLidarResyncTime = millis();
    lastPiCmd = 'S';
    centerServos();
    stopMotors();
    flushPiSerial();
    sendPiMessage("LIDAR:START");
    updateLcdDisplay();
    return;
  }

  if (cmd == 'H') {
    currentMode = MODE_DUAL_FUSION;
    dualState = DUAL_PASS_THROUGH;
    lastLidarCmdTime = millis();
    lastLidarResyncTime = millis();
    lastPiCmd = 'S';
    distFC = distFL = distFR = distL = distR = 999;
    centerServos();
    stopMotors();
    flushPiSerial();
    sendPiMessage("LIDAR:START");
    updateLcdDisplay();
    return;
  }

  if (cmd == 'T') {
    currentMode = MODE_TEST;
    autoState = AUTO_IDLE;
    dualState = DUAL_PASS_THROUGH;
    centerServos();
    stopMotors();
    flushPiSerial();
    sendPiMessage("LIDAR:TEST");
    lastLidarResyncTime = millis();
    updateLcdDisplay();
    return;
  }

  if (cmd == 'M') {
    if (currentMode == MODE_LIDAR || currentMode == MODE_DUAL_FUSION) {
      sendPiMessage("LIDAR:STOP");
    }
    currentMode = MODE_MANUAL;
    autoState = AUTO_IDLE;
    dualState = DUAL_PASS_THROUGH;
    centerServos();
    stopMotors();
    flushPiSerial();
    updateLcdDisplay();
    return;
  }

  if (currentMode != MODE_MANUAL) {
    if (currentMode == MODE_LIDAR || currentMode == MODE_DUAL_FUSION) {
      sendPiMessage("LIDAR:STOP");
    }
    currentMode = MODE_MANUAL;
    autoState = AUTO_IDLE;
    dualState = DUAL_PASS_THROUGH;
    centerServos();
    stopMotors();
    flushPiSerial();
    updateLcdDisplay();
  }

  executeMotorCommand(cmd);
}

// ======================================================
// SERIAL HELPERS (Pi Handshake)
// ======================================================
void sendPiMessage(const char* msg) {
  Serial.println(msg);
  Serial2.println(msg);
}

void flushPiSerial() {
  while (Serial.available() > 0) Serial.read();
  while (Serial2.available() > 0) Serial2.read();
}

// ======================================================
// DUAL FUSION MODE (RPi 2D LiDAR + 5x Ultrasonic Ground Shield)
// ======================================================
void runDualFusion(char piCmd, bool hasNewPiCmd) {
  unsigned long now = millis();
  
  // Use healthy sensors only
  long effFC = sensorHealthy[0] ? distFC : 999;
  long effFL = sensorHealthy[1] ? distFL : 999;
  long effFR = sensorHealthy[2] ? distFR : 999;
  long effL  = sensorHealthy[3] ? distL  : 999;
  long effR  = sensorHealthy[4] ? distR  : 999;

  long frontMin = min(effFC, min(effFL, effFR));

  switch (dualState) {
    case DUAL_PASS_THROUGH:
      if (frontMin < DUAL_CRITICAL_CM) {
        stopMotors();
        moveBackward();
        dualState = DUAL_BACKUP;
        dualOverrideStart = now;
        return;
      }

      if (frontMin < DUAL_FRONT_CM && (piCmd == 'F' || piCmd == 'I' || piCmd == 'O')) {
        stopMotors();
        if (effL < SIDE_BLOCK_DIST_CM && effR >= SIDE_BLOCK_DIST_CM) {
          dualTurnDir = 1;
        } else if (effR < SIDE_BLOCK_DIST_CM && effL >= SIDE_BLOCK_DIST_CM) {
          dualTurnDir = -1;
        } else {
          dualTurnDir = (effL > effR) ? -1 : 1;
        }
        if (dualTurnDir < 0) rotateLeft();
        else rotateRight();
        dualState = DUAL_ROTATE;
        dualOverrideStart = now;
        return;
      }

      if (piCmd == 'F') {
        if (effL < DUAL_SIDE_CM && effR >= DUAL_SIDE_CM) {
          moveFrontRight();
          return;
        } else if (effR < DUAL_SIDE_CM && effL >= DUAL_SIDE_CM) {
          moveFrontLeft();
          return;
        }
      }

      if (hasNewPiCmd) {
        executeMotorCommand(piCmd);
      }
      break;

    case DUAL_BACKUP:
      if (now - dualOverrideStart >= 320) {
        stopMotors();
        dualTurnDir = (effL > effR) ? -1 : 1;
        if (dualTurnDir < 0) rotateLeft();
        else rotateRight();
        dualState = DUAL_ROTATE;
        dualOverrideStart = now;
      }
      break;

    case DUAL_ROTATE:
      if (effFC > DUAL_CLEAR_CM && effFL > DUAL_CLEAR_CM && effFR > DUAL_CLEAR_CM) {
        dualState = DUAL_PASS_THROUGH;
        executeMotorCommand(piCmd);
      } else if (now - dualOverrideStart > 3000) {
        moveBackward();
        dualState = DUAL_BACKUP;
        dualOverrideStart = now;
      }
      break;
  }
}

// ======================================================
// ULTRASONIC AUTONOMOUS MODE (5x HC-SR04)
// ======================================================
void runUltrasonicAuto() {
  unsigned long now = millis();

  // Fault-tolerant sensor reading: failed sensors report 999 and do not block the rover
  long effFC = sensorHealthy[0] ? distFC : 999;
  long effFL = sensorHealthy[1] ? distFL : 999;
  long effFR = sensorHealthy[2] ? distFR : 999;
  long effL  = sensorHealthy[3] ? distL  : 999;
  long effR  = sensorHealthy[4] ? distR  : 999;

  switch (autoState) {
    case AUTO_IDLE:
      moveForward();
      autoState = AUTO_FORWARD;
      autoStateStartTime = now;
      break;

    case AUTO_FORWARD:
      updateServoSweep();

      if (effFC < CRITICAL_DIST_CM || effFL < CRITICAL_DIST_CM || effFR < CRITICAL_DIST_CM) {
        stopMotors();
        centerServos();
        moveBackward();
        autoState = AUTO_BACKUP;
        autoStateStartTime = now;
        return;
      }

      if (effFC < OBSTACLE_DIST_CM || effFL < OBSTACLE_DIST_CM || effFR < OBSTACLE_DIST_CM) {
        stopMotors();
        centerServos();

        bool rightBlocked = (effR < SIDE_BLOCK_DIST_CM);
        bool leftBlocked  = (effL < SIDE_BLOCK_DIST_CM);

        if (rightBlocked && !leftBlocked) {
          turnDirection = -1;
        } else if (leftBlocked && !rightBlocked) {
          turnDirection = 1;
        } else if (rightBlocked && leftBlocked) {
          moveBackward();
          autoState = AUTO_BACKUP;
          autoStateStartTime = now;
          return;
        } else {
          if (abs(effL - effR) > 8) {
            turnDirection = (effL > effR) ? -1 : 1;
          } else if (effFL < effFR - 3) {
            turnDirection = 1;
          } else if (effFR < effFL - 3) {
            turnDirection = -1;
          } else {
            turnDirection = (effL >= effR) ? -1 : 1;
          }
        }

        autoState = AUTO_ROTATE;
        autoStateStartTime = now;
        if (turnDirection < 0) rotateLeft();
        else rotateRight();
        return;
      }

      // Side wall repulsion using normal 4WD skid-steer curves
      if (effL < SIDE_AVOID_DIST_CM && effR >= SIDE_AVOID_DIST_CM) {
        moveFrontRight();
      } else if (effR < SIDE_AVOID_DIST_CM && effL >= SIDE_AVOID_DIST_CM) {
        moveFrontLeft();
      } else {
        moveForward();
      }
      break;

    case AUTO_BACKUP:
      centerServos();
      if (now - autoStateStartTime >= 350) {
        stopMotors();
        turnDirection = (effL > effR) ? -1 : 1;
        if (turnDirection < 0) rotateLeft();
        else rotateRight();
        autoState = AUTO_ROTATE;
        autoStateStartTime = now;
      }
      break;

    case AUTO_ROTATE:
      centerServos();
      if (effFC > CLEAR_DIST_CM && effFL > CLEAR_DIST_CM && effFR > CLEAR_DIST_CM) {
        stopMotors();
        delay(30);
        moveForward();
        autoState = AUTO_FORWARD;
        autoStateStartTime = now;
        return;
      }
      if (now - autoStateStartTime > 4000) {
        stopMotors();
        moveBackward();
        autoState = AUTO_BACKUP;
        autoStateStartTime = now;
      }
      break;
  }
}

// ======================================================
// NON-BLOCKING ROUND-ROBIN ULTRASONIC POLLING WITH HEALTH
// ======================================================
void updateSensorHealth(uint8_t idx, long d) {
  if (d >= 999) {
    if (sensorFailCount[idx] < 255) sensorFailCount[idx]++;
    if (sensorFailCount[idx] > 25) {
      sensorHealthy[idx] = false;
    }
  } else {
    sensorFailCount[idx] = 0;
    sensorHealthy[idx] = true;
  }

  uint8_t count = 0;
  for (int i = 0; i < 5; i++) {
    if (sensorHealthy[i]) count++;
  }
  healthySensorCount = count;
}

void pollNextUltrasonic() {
  switch (nextSensorIdx) {
    case 0:
      distFC = readDistance(TRIG_FC, ECHO_FC);
      updateSensorHealth(0, distFC);
      break;
    case 1:
      distFL = readDistance(TRIG_FL, ECHO_FL);
      updateSensorHealth(1, distFL);
      break;
    case 2:
      distFR = readDistance(TRIG_FR, ECHO_FR);
      updateSensorHealth(2, distFR);
      break;
    case 3:
      distL  = readDistance(TRIG_L,  ECHO_L);
      updateSensorHealth(3, distL);
      break;
    case 4:
      distR  = readDistance(TRIG_R,  ECHO_R);
      updateSensorHealth(4, distR);
      break;
  }
  nextSensorIdx = (nextSensorIdx + 1) % 5;
}

long readDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 12000);
  if (duration == 0) return 999;
  long cm = (duration * 343L) / 20000L;
  return (cm <= 0) ? 999 : cm;
}

// ======================================================
// MOTOR COMMAND DISPATCHER & 4WD SKID-STEER KINEMATICS
// ======================================================
void executeMotorCommand(char cmd) {
  // Lockout all motor movements while in Proximity Hold
  if (isProximityHold && cmd != 'S') {
    stopMotors();
    return;
  }

  switch (cmd) {
    case 'F': moveForward(); break;
    case 'B': moveBackward(); break;
    case 'L': moveLeft(); break;
    case 'R': moveRight(); break;
    case 'Q': rotateLeft(); break;
    case 'E': rotateRight(); break;
    case 'q': stepRotateLeft(); break;
    case 'e': stepRotateRight(); break;
    case 'I': moveFrontLeft(); break;
    case 'O': moveFrontRight(); break;
    case 'J': moveBackLeft(); break;
    case 'K': moveBackRight(); break;
    case 'S': stopMotors(); break;
    default:  stopMotors(); break;
  }
}

void motorFL(int dir) {
  digitalWrite(FL_IN1, dir > 0 ? HIGH : LOW);
  digitalWrite(FL_IN2, dir < 0 ? HIGH : LOW);
}

void motorFR(int dir) {
  digitalWrite(FR_IN1, dir > 0 ? HIGH : LOW);
  digitalWrite(FR_IN2, dir < 0 ? HIGH : LOW);
}

void motorRL(int dir) {
  digitalWrite(RL_IN1, dir > 0 ? HIGH : LOW);
  digitalWrite(RL_IN2, dir < 0 ? HIGH : LOW);
}

void motorRR(int dir) {
  digitalWrite(RR_IN1, dir > 0 ? HIGH : LOW);
  digitalWrite(RR_IN2, dir < 0 ? HIGH : LOW);
}

void stopMotors() {
  isStepping = false;
  motorFL(0); motorFR(0); motorRL(0); motorRR(0);
}

void moveForward()  { motorFL(1);  motorFR(1);  motorRL(1);  motorRR(1);  }
void moveBackward() { motorFL(-1); motorFR(-1); motorRL(-1); motorRR(-1); }

// 4WD Skid-Steer In-Place Tank Turns
void rotateLeft()   { motorFL(-1); motorFR(1);  motorRL(-1); motorRR(1);  }
void rotateRight()  { motorFL(1);  motorFR(-1); motorRL(1);  motorRR(-1); }
void moveLeft()     { rotateLeft();  }
void moveRight()    { rotateRight(); }

void stepRotateLeft() {
  rotateLeft();
  isStepping = true;
  stepEndTime = millis() + ROTATION_STEP_MS;
}

void stepRotateRight() {
  rotateRight();
  isStepping = true;
  stepEndTime = millis() + ROTATION_STEP_MS;
}

// 4WD Skid-Steer Smooth Curves (Normal Wheels)
void moveFrontLeft()  { motorFL(0);  motorFR(1);  motorRL(0);  motorRR(1);  } // Right bank drives -> curves Left
void moveFrontRight() { motorFL(1);  motorFR(0);  motorRL(1);  motorRR(0);  } // Left bank drives  -> curves Right
void moveBackLeft()   { motorFL(0);  motorFR(-1); motorRL(0);  motorRR(-1); } // Right bank reverses -> curves Back-Left
void moveBackRight()  { motorFL(-1); motorFR(0);  motorRL(-1); motorRR(0);  } // Left bank reverses  -> curves Back-Right

// ======================================================
// SERVO HELPERS
// ======================================================
void centerServos() {
  currentServoAngle = SERVO_CENTER;
  servoFL.write(SERVO_CENTER);
  servoFR.write(SERVO_CENTER);
}

void updateServoSweep() {
  if (!ENABLE_SERVO_SWEEP) return;
  unsigned long now = millis();
  if (now - lastServoStepTime >= SERVO_STEP_INTERVAL) {
    lastServoStepTime = now;
    currentServoAngle += servoDirection * SERVO_STEP;
    if (currentServoAngle >= SERVO_SWEEP_MAX) {
      currentServoAngle = SERVO_SWEEP_MAX;
      servoDirection = -1;
    } else if (currentServoAngle <= SERVO_SWEEP_MIN) {
      currentServoAngle = SERVO_SWEEP_MIN;
      servoDirection = 1;
    }
    servoFL.write(currentServoAngle);
    servoFR.write(currentServoAngle);
  }
}
